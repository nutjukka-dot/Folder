{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio project item with details, screenshots, and links",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project"
        },
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "tagline": {
          "type": "string",
          "description": "Short summary or tagline"
        },
        "description": {
          "type": "string",
          "description": "Full Markdown description of the project"
        },
        "category": {
          "type": "string",
          "description": "Project category (e.g. Full-Stack, AI / ML, Mobile App, Developer Tool)"
        },
        "tags": {
          "type": "array",
          "description": "Array of tech stack tags like React, Next.js, TypeScript"
        },
        "coverImage": {
          "type": "string",
          "description": "Cover screenshot URL or base64"
        },
        "images": {
          "type": "array",
          "description": "List of screenshot image URLs"
        },
        "liveUrl": {
          "type": "string",
          "description": "Live demo URL"
        },
        "repoUrl": {
          "type": "string",
          "description": "GitHub repository URL"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether this project is highlighted or pinned"
        },
        "order": {
          "type": "number",
          "description": "Display order in portfolio"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["title", "tagline", "description", "category"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Showcase portfolio projects readable by everyone and editable by the portfolio admin"
    }
  }
}
